import React, { useState, useEffect } from 'react';

function App() {
  const [items, setItems] = useState([]);

  // GET
  useEffect(() => {
    fetch('http://localhost:5000/api/items')
      .then(res => res.json())
      .then(data => setItems(data.items));
  }, []);

  // POST
  const addItem = () => {
    fetch('http://localhost:5000/api/items', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: 'New Item' })
    })
      .then(res => res.json())
      .then(data => alert(data.message));
  };

  // PUT
  const replaceItem = () => {
    fetch('http://localhost:5000/api/items/1', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: 'Replaced Item' })
    })
      .then(res => res.json())
      .then(data => alert(data.message));
  };

  // PATCH
  const updateItem = () => {
    fetch('http://localhost:5000/api/items/1', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: 'Patched Item' })
    })
      .then(res => res.json())
      .then(data => alert(data.message));
  };

  // DELETE
  const deleteItem = () => {
    fetch('http://localhost:5000/api/items/1', { method: 'DELETE' })
      .then(res => res.json())
      .then(data => alert(data.message));
  };

  return (
    <div style={{ padding: '20px' }}>
      <h1>React + Express CRUD Demo</h1>
      <button onClick={addItem}>POST (Add Item)</button>
      <button onClick={replaceItem}>PUT (Replace Item)</button>
      <button onClick={updateItem}>PATCH (Update Item)</button>
      <button onClick={deleteItem}>DELETE (Remove Item)</button>

      <h2>Items:</h2>
      <ul>
        {items.map(i => <li key={i.id}>{i.name}</li>)}
      </ul>
    </div>
  );
}

export default App;
